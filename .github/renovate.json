{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:weekly",
    ":automergeMinor",
    ":automergeDigest"
  ],
  "labels": [
    "dependencies"
  ],
  "pinDigests": true,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "description": "Major bumps require human review \u2014 breaking changes possible"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "groupName": "cargo non-major",
      "description": "Group routine cargo updates to keep PR noise down"
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "groupName": "dockerfile non-major"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "digest"
      ],
      "groupName": "github-actions non-major",
      "description": "Group action SHA bumps \u2014 pinDigests keeps these flowing"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": [
      "at any time"
    ],
    "automerge": true,
    "labels": [
      "security",
      "cve"
    ],
    "description": "Bypass routine schedule and grouping \u2014 CVE patches ship within an hour of advisory publication, auto-merged on green CI. prPriority does NOT belong here: Renovate rejects it under vulnerabilityAlerts and it is the cause of the 'Found renovate config warnings' badge."
  },
  "osvVulnerabilityAlerts": true
}
