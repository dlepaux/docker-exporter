# docker-exporter configuration
# All values shown are defaults — only set what you want to override.

# Address to bind the HTTP server
# LISTEN_ADDR=0.0.0.0:9713

# Log level: trace, debug, info, warn, error
# LOG_LEVEL=info

# Comma-separated container names to exclude from metrics
# EXCLUDE_CONTAINERS=

# Override LOG_LEVEL with the standard tracing filter syntax for finer control:
# RUST_LOG=docker_exporter=debug,bollard=warn
